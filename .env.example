# URL pública definitiva (sem barra final). Configure na Vercel em Production, Preview e Development.
VITE_SITE_URL=https://seu-dominio.com.br

# Valores públicos do projeto Supabase. A chave anon pode ficar no frontend;
# nunca exponha SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Exclusivos do servidor Vercel (sem prefixo VITE_):
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
PAYMENT_WEBHOOK_SECRET=gere-um-segredo-longo-e-aleatorio
